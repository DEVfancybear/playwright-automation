{
  "name": "@duong.dev/playwright-automation",
  "version": "3.0.1",
  "description": "Agent Skill tự chủ cho Codex và Claude: auto-login, explore → auto-plan → generate → execute → heal → verdict; relaxed trên non-production, guarded tại ranh giới rủi ro.",
  "keywords": [
    "codex",
    "openai",
    "claude",
    "claude-code",
    "agent-skill",
    "agent-skills",
    "claude-skill",
    "playwright",
    "testing",
    "automation",
    "browser-automation",
    "e2e",
    "e2e-testing",
    "api-testing",
    "visual-regression",
    "accessibility",
    "qa",
    "tester",
    "typescript"
  ],
  "homepage": "https://github.com/DEVfancybear/playwright-automation#readme",
  "bugs": {
    "url": "https://github.com/DEVfancybear/playwright-automation/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DEVfancybear/playwright-automation.git"
  },
  "license": "Apache-2.0",
  "author": "DuongLT",
  "bin": {
    "playwright-automation": "bin/install.mjs"
  },
  "files": [
    "SKILL.md",
    "CHANGELOG.md",
    "agents/",
    "bin/",
    "references/",
    "scripts/*.mjs",
    "scripts/*.cjs",
    "scripts/*.py",
    "assets/",
    "docs/",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/installer.test.mjs tests/auth-login.integration.test.mjs tests/mcp-auth-bridge.integration.test.mjs tests/skill-contract.test.mjs",
    "test:auth": "node --test --test-concurrency=1 tests/auth-login.integration.test.mjs",
    "test:bridge": "node --test --test-concurrency=1 tests/mcp-auth-bridge.integration.test.mjs",
    "test:mutation": "node tools/mutate-auth-tests.mjs && node tools/mutate-bridge-tests.mjs",
    "gauntlet": "node tools/release-gauntlet.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1"
  }
}
