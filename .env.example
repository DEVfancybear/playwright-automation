# Chạy `npm run auth:setup` để tự tạo `.env` local từ skeleton an toàn.
# Không copy credential từ assets/template, examples hoặc fixtures.
# `.env` đã được gitignore; không commit và không gửi giá trị qua chat.

TEST_USER=
TEST_PASS=

# Bỏ trống nếu tài khoản test không dùng TOTP.
TEST_TOTP_SECRET=
