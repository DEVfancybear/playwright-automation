# Sao chép file này thành .env rồi điền giá trị thật.
# .env đã được .gitignore — KHÔNG commit, kể cả tài khoản staging.

# Môi trường cần test
BASE_URL={{BASE_URL}}
API_URL={{API_URL}}

# Tài khoản test thường
# Môi trường hiển thị khi chạy test (bỏ trống = vi-VN / Asia/Ho_Chi_Minh).
# Hai giá trị này đổi format ngày/số của app, đặt khớp môi trường tester dùng khi log bug.
TEST_LOCALE=
TEST_TZ=

TEST_USER=
TEST_PASS=

# 2FA bằng app Authenticator: dán secret dạng base32 (chuỗi hiện khi quét QR).
# Để trống nếu tài khoản test được miễn 2FA — đó là cách nên xin backend làm.
TEST_TOTP_SECRET=

# Tài khoản quản trị (nếu cần test phân quyền)
ADMIN_USER=
ADMIN_PASS=

# Chạy trên môi trường khác mà không sửa file:
#   Linux/macOS:  BASE_URL=https://uat.example.com npx playwright test
#   PowerShell:   $env:BASE_URL="https://uat.example.com"; npx playwright test
